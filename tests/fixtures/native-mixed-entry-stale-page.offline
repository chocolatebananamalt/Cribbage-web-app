import {createRoot} from 'react-dom/client';import {useMemo,useState} from 'react';import {NativeMixedDigitalScoreEntryV1} from '../../src/components/native-mixed-digital-score-entry-v1';import {NativeMixedPaperEntryV1} from '../../src/components/native-mixed-paper-entry-v1';
import {NativeMixedGamePendingControllerV1} from '../../src/lib/seating/native-mixed-game-pending-v1';
const getSnapshot=NativeMixedGamePendingControllerV1.prototype.getSnapshot;NativeMixedGamePendingControllerV1.prototype.getSnapshot=function(){window.__lastController=this;const snapshot=getSnapshot.call(this);if(window.__snapshotNoise)snapshot.message+=' '+window.__snapshotNoise;return snapshot;};
const data=window.__fixture,rows=new Map();window.__rows=rows;window.__entryCounts={ids:0,artifacts:0,transitions:0,writes:0,recover:0,resolve:0,state:0};window.__sent=[];window.__source=structuredClone(data.state);window.__snapshotNoise=0;
const retained={read:async key=>rows.get(key)??null,transition:async(key,old,next,archive,signal)=>{window.__entryCounts.transitions++;if(signal?.aborted||(rows.get(key)??null)!==old)return false;if(next===null)rows.delete(key);else rows.set(key,next);return true;}};
const transport={state:async()=>{window.__entryCounts.state++;return{data:structuredClone(window.__source),error:null};},write:async(target,request)=>{window.__entryCounts.writes++;window.__sent.push({target,request});if(window.__holdWrite)await new Promise(r=>window.__releaseWrite=r);return{data:null,error:'operation_outcome_unknown'};},recover:async()=>{window.__entryCounts.recover++;return{data:null,error:'operation_outcome_unknown'};},resolve:async()=>{window.__entryCounts.resolve++;return{data:null,error:'operation_outcome_unknown'};}};let sequence=700;
function App(){const[generation,setGeneration]=useState(0),[runtimeGeneration,setRuntimeGeneration]=useState(0),[targetGeneration,setTargetGeneration]=useState(0),[online,setOnline]=useState(true),[enabled,setEnabled]=useState(true),runtime=useMemo(()=>({retained,transport,makeOperationId:()=>{window.__entryCounts.ids++;return`00000000-0000-4000-8000-${String(sequence++).padStart(12,'0')}`;},makeArtifactId:()=>{window.__entryCounts.artifacts++;return`00000000-0000-4000-8000-${String(sequence++).padStart(12,'0')}`;}}),[runtimeGeneration]),binding=useMemo(()=>{const b=structuredClone(data.binding);if(targetGeneration){b.target.gameId='00000000-0000-4000-8000-000000000077';window.__source.gameId=b.target.gameId;}return b;},[targetGeneration]);return <main style={{minWidth:0,overflowWrap:'anywhere'}}><nav><button onClick={()=>{rows.clear();window.__entryCounts={ids:0,artifacts:0,transitions:0,writes:0,recover:0,resolve:0,state:0};window.__sent=[];window.__source=structuredClone(data.state);window.__snapshotNoise=0;setGeneration(n=>n+1);setOnline(true);setEnabled(true);setTargetGeneration(0);}}>Reset Entry</button><button onClick={()=>setRuntimeGeneration(n=>n+1)}>Replace Runtime</button><button onClick={()=>setTargetGeneration(n=>n+1)}>Replace Target</button><button onClick={()=>setOnline(false)}>Go Offline</button><button onClick={()=>setOnline(true)}>Reconnect</button><button onClick={()=>setEnabled(false)}>Disable Entry</button></nav>{data.kind==='digital'?<NativeMixedDigitalScoreEntryV1 key={generation} enabled={enabled} binding={binding} initialState={data.state} online={online} runtime={runtime}/>:<NativeMixedPaperEntryV1 key={generation} enabled={enabled} binding={binding} initialState={data.state} online={online} runtime={runtime}/>}</main>;}
createRoot(document.getElementById('root')).render(<App/>);

