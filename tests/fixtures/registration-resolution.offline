import React from'react';import{createRoot}from'react-dom/client';import{RegistrationResolutionReviewV1}from'../../src/components/registration-resolution-v1';const id=(n:number)=>'a0000000-0000-4000-8000-'+String(n).padStart(12,'0');window.ids={actorId:id(1),tournamentId:id(2),sessionId:id(3)};window.stored=null;window.sent=[];window.outcome=null;Object.defineProperty(crypto,'randomUUID',{value:()=>id(4)});window.fetch=async(url:any,o:any)=>{if(!o?.body)return{ok:true,json:async()=>({kind:'registration-resolution-workspace-v1',actorId:id(1),tournamentId:id(2),claims:[],records:[]})};const b=JSON.parse(o.body);window.sent.push(b);return{json:async()=>window.outcome};};createRoot(document.getElementById('root')!).render(<RegistrationResolutionReviewV1 {...window.ids}/>);