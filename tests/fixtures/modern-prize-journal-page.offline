import{NativePoolAwardResultsV2}from'../../src/components/native-pool-award-results-v2';
import{ModernPrizeResultsV2}from'../../src/components/modern-prize-results-v2';
import{createRoot}from'react-dom/client';import{ModernPrizeJournalSectionV2}from'../../src/components/modern-prize-journal-section-v2';
const id=n=>`90000000-0000-4000-8000-${String(n).padStart(12,'0')}`,scope={actorId:id(1),tournamentId:id(2),eventId:id(3)},groups=[[1,1],[2,2],[3,4]].map(([firstPlace,lastPlace])=>({firstPlace,lastPlace,people:lastPlace-firstPlace+1,included:true,perPersonMinor:1000,groupTotalMinor:(lastPlace-firstPlace+1)*1000,members:Array.from({length:lastPlace-firstPlace+1},(_,i)=>({participantId:id(20+firstPlace+i),displayName:'Fictional Player '+(firstPlace+i),tournamentPlayerId:'A-'+(firstPlace+i)}))})),review={kind:'modern-prize-review-v2',...scope,sourceDigest:'a'.repeat(64),prizeRevisionId:id(4),fundReviewId:id(5),method:'equal',methodParameterText:null,roundingUnitMinor:500,totalMinor:4000,groups};
const values=new Map(),archives=[];window.sends=[];window.writes=0;let lost=true;const storage={read:async k=>values.get(k)??null,transition:async(k,old,next,archive)=>{if((values.get(k)??null)!==old)return false;if(next===null)values.delete(k);else values.set(k,next);if(archive)archives.push(archive);return true;}},port={read:async()=>({status:'review',review}),save:async a=>{window.sends.push(JSON.stringify(a));if(lost){lost=false;window.writes++;throw Error('lost after commit');}return{status:'accepted',attempt:a,awardSetId:id(99),record:review};}};
const subscribeIdentity=f=>{window.identity=f;return()=>{window.identity=null;}};window.showMethod=method=>{review.method=method;review.methodParameterText=method==='graduated'?'2':'3';review.sourceDigest=method==='graduated'?'c'.repeat(64):'d'.repeat(64);review.groups.forEach((g,i)=>{g.included=i<2;g.perPersonMinor=i===0?(method==='graduated'?2500:3000):i===1?(method==='graduated'?1500:1000):0;g.groupTotalMinor=g.people*g.perPersonMinor;});};window.showFeeComparison=()=>{review.method='graduated';review.methodParameterText='2';review.roundingUnitMinor=500;review.groups.forEach((g,i)=>{g.included=true;g.perPersonMinor=[2000,1000,500][i];g.groupTotalMinor=g.people*g.perPersonMinor;});review.entryFeeComparison={entryFeeMinor:250,choice:'more',firstPlace:3,lastPlace:4,perPersonMinor:500};review.sourceDigest='e'.repeat(64);};window.changeReview=()=>{review.sourceDigest='b'.repeat(64);};
window.retained=()=>({values:[...values.values()],archives});const root=createRoot(document.getElementById('root'));window.mount=(verified=true,role='director')=>root.render(<ModernPrizeJournalSectionV2 enabled scope={scope} role={role} subscribeIdentity={subscribeIdentity} writesVerified={verified} port={port} storage={storage} makeOperationId={()=>id(88)}/>);

window.mountResults=()=>root.render(<><p>LOCAL FICTIONAL DISPLAY ONLY</p><ModernPrizeResultsV2 view={{status:'available',eventKind:'main',method:'graduated',roundingUnitMinor:500,totalMinor:3000,recordedAt:'2026-11-10T12:00:00Z',sourceObservation:'locked_database_capture',moneyMoved:false,payoutAuthorized:false,groups:groups.map((g,i)=>({firstPlace:g.firstPlace,lastPlace:g.lastPlace,included:i<2,perPersonMinor:[2000,1000,0][i],groupTotalMinor:[2000,1000,0][i],members:g.members.map(p=>({name:p.displayName,tournamentPlayerId:p.tournamentPlayerId}))}))}}/></>);

window.mountPoolResults=()=>root.render(<><p>LOCAL FICTIONAL DISPLAY ONLY</p><NativePoolAwardResultsV2 view={{status:'available',qMinor:1000,sideMinor:1500,totalMinor:2500,recordedAt:'2026-11-10T12:00:00Z',moneyMoved:false,payoutAuthorized:false,pools:[{poolId:id(301),label:'Q-Pool 1 - Equal',kind:'q',fundMinor:1000,roundingUnitMinor:500,recipients:[{name:'Fictional Pool Player One',tournamentPlayerId:'A-1',amountMinor:500},{name:'Fictional Pool Player Two',tournamentPlayerId:'A-2',amountMinor:500}]},{poolId:id(302),label:'Ten Dollar Side Pool',kind:'side',fundMinor:1500,roundingUnitMinor:500,recipients:[{name:'Fictional Pool Player One',tournamentPlayerId:'A-1',amountMinor:1000},{name:'Fictional Pool Player Three',tournamentPlayerId:'A-3',amountMinor:500}]}]}}/></>);

window.showReviewedIncome=()=>{review.reviewedAdditionalIncomeMinor=1000;review.sourceDigest='f'.repeat(64);};
