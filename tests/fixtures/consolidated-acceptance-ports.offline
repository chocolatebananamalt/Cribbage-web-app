import React from 'react';
const forbidden=()=>{window.fixtureStats.forbiddenActions++;throw Error('No cleanup or score mutation is permitted by these fixture ports');};
const router={refresh:()=>window.refreshScore()};
export const useRouter=()=>router;
export const PlayerPageFrame=({children})=><main>{children}</main>;
export const GamePlayerLocation=({label,playerId})=><span>{label} {playerId}</span>;
export const ManualMixedHandoffV1=()=>null,MakeupCardLines=()=>null,JudgeCallButton=()=>null;
export const setAppRecoveryItem=(storage,key,value)=>{window.fixtureStats.recoveryWrites++;storage.setItem(key,value);};
export const compareAndReplaceAppRecoveryItem=(storage,key,old,next)=>{if(storage.getItem(key)!==old)return false;if(next===null)storage.removeItem(key);else storage.setItem(key,next);return true;};
export const trackAppRecoveryWrite=fn=>fn();
export const assertRecoveryWriteAllowed=()=>{};
export const beginSafeRecoverySwitch=forbidden,cancelSafeRecoverySwitch=forbidden,markRecoveryCleanupStarted=forbidden,finishSafeRecoverySwitch=forbidden,failSafeRecoverySwitch=forbidden,finishPreservingRecoverySignOut=forbidden;
export const protectUnownedRecovery=forbidden,clearRecoveryStorageOwner=forbidden;
export const countAppSessionStorageRecords=()=>window.fixtureCounts.retry;
export const countOfflineSubmissions=async()=>window.fixtureCounts.offline;
export const clearAppSessionStorage=forbidden,clearOfflineScoreStorage=forbidden;
export const deleteOfflineSubmission=forbidden,queueOfflineSubmission=forbidden,replayOfflineSubmission=forbidden;
export const readOfflineSubmission=async()=>null,readPreparedOfflineSubmissionCapability=async()=>null,provisionOfflineSubmission=async()=>null;
export const prepareCurrentScorePageForOffline=async()=>false;
void React;
