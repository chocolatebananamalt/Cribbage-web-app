import {createRoot} from 'react-dom/client';import {useMemo,useState} from 'react';
import {PlayoffPrizeFinanceSectionV2} from '../../src/components/playoff-prize-finance-section-v2';
const data=window.__fixture,memory=new Map(),archives=new Map(),counts={reads:0,saves:0,checks:0,transitions:0,archiveReads:0};
window.__memory=memory;window.__archives=archives;window.__counts=counts;
const retained={async read(key){return memory.get(key)??null;},async transition(key,expected,next,archive,signal){counts.transitions++;if(signal?.aborted||window.__archiveFail&&archive||memory.get(key)!==expected&&!(expected===null&&!memory.has(key)))return false;if(next===null)memory.delete(key);else memory.set(key,next);if(archive)archives.set(archive.id,archive.raw);if(archive&&window.__loseArchiveAck){window.__loseArchiveAck=false;throw Error('Fictional committed archive with lost acknowledgement');}return true;}};
retained.readPrizeArchives=async(scope,after,limit)=>{counts.archiveReads++;if(window.__holdArchives){window.__holdArchives=false;await new Promise(r=>window.__releaseArchives=r);}const suffix=`:${scope.actorId}:${scope.tournamentId}:${scope.eventId}:`,rows=[...archives].filter(([key])=>(key.startsWith('prize-proposal-receipt-v2'+suffix)||key.startsWith('prize-proposal-rejection-v2'+suffix))&&(after===null||key>after)).sort(([a],[b])=>a<b?-1:a>b?1:0),entries=rows.slice(0,limit).map(([id,raw])=>({id,raw:typeof raw==='string'?raw:null}));return{entries,nextCursor:rows.length>limit?entries.at(-1).id:null};};
const port={async workspace(){counts.reads++;if(window.__holdRead){window.__holdRead=false;await new Promise(r=>window.__releaseRead=r);}const value=await window.__server('workspace');if(window.__readUnavailable)return{};if(window.__mismatchRead&&value.head)value.head.reason+=' changed';return value;},async save(prepared){counts.saves++;const value=await window.__server('save',prepared);if(window.__holdSave){window.__holdSave=false;await new Promise(r=>window.__releaseSave=r);}if(window.__loseSave){window.__loseSave=false;throw Error('Fictional lost reply');}if(window.__attempt)return{kind:'playoff-prize-proposal-attempt-v2',...prepared.scope,operationId:prepared.request.operationId,requestHash:prepared.hash,status:'rejected',code:'not_immutable'};return value;},async recover(prepared){counts.checks++;if(window.__unknown)return{};const value=await window.__server('recover',prepared);if(window.__badRejection&&value?.result?.status==='rejected')value.result.code='different_recorded_code';return value;}};
let op=100;
function App(){const[generation,setGeneration]=useState(0),[enabled,setEnabled]=useState(true),[role,setRole]=useState('director'),[other,setOther]=useState(false),[ports,setPorts]=useState(0),portsValue=useMemo(()=>({port:{...port},retained:{...retained,readPrizeArchives:window.__archivePortOff?undefined:retained.readPrizeArchives}}),[ports]);return <main style={{maxWidth:1100,margin:'0 auto',padding:12,minWidth:0,overflowWrap:'anywhere'}}><h1>Fictional Finance UI Acceptance</h1><nav aria-label="Fixture Controls"><button onClick={()=>setGeneration(n=>n+1)}>Remount Finance</button><button onClick={()=>setPorts(n=>n+1)}>Replace Finance Ports</button><button onClick={()=>setEnabled(false)}>Disable Finance</button><button onClick={()=>setEnabled(true)}>Enable Finance</button><button onClick={()=>{setOther(true);setRole('player');}}>Switch to Other Account</button><button onClick={()=>{setOther(false);setRole('director');}}>Restore Director</button></nav><PlayoffPrizeFinanceSectionV2 key={generation} enabled={enabled} scope={other?{...data.scope,actorId:'92000000-0000-4000-8000-000000000099'}:data.scope} role={role} retained={portsValue.retained} port={portsValue.port} makeOperationId={()=>`92000000-0000-4000-8000-${String(op++).padStart(12,'0')}`}/></main>;}
createRoot(document.getElementById('root')).render(<App/>);

