import React from'react';import{createRoot}from'react-dom/client';import{NativeMixedGameReopenV1}from'../../src/components/native-mixed-game-reopen-v1';const root=createRoot(document.getElementById('root')!);window.calls=[];let next=200;window.mount=(mode='review')=>{const w=structuredClone(window.workspace),c=structuredClone(window.context);if(mode!=='propose'){c.actorId='00000000-0000-4000-8000-000000000099';w.actorId=c.actorId;w.state.actorId=c.actorId;w.canPropose=false;w.canReview=mode!=='self';w.latestProposal={id:'00000000-0000-4000-8000-000000000092',status:'pending',reason:'Original independent Director proposal',recordedAt:'2026-11-11T00:00:00Z',policyVersion:w.policy.version,expectedStartSourceDigest:w.startSourceDigest,expectedRevision:w.revision,expectedHistoryDigest:w.historyDigest};}if(mode==='stale')w.blockedCode='later_evidence_exists';const rows=new Map();const runtime={context:c,enabled:()=>true,online:()=>true,makeOperationId:()=>'00000000-0000-4000-8000-'+String(next++).padStart(12,'0'),retained:{read:async k=>rows.get(k)??null,transition:async(k,b,n)=>{if((rows.get(k)??null)!==b)return false;n===null?rows.delete(k):rows.set(k,n);return true;}},read:async()=>structuredClone(w),write:async(op,r)=>{window.calls.push(r);const status=r.action==='propose'?'pending':r.action==='reject'?'declined':'reopened';return{kind:'native-mixed-game-reopen-receipt-v1',status,code:status==='pending'?'approval_pending':status==='declined'?'proposal_declined':'game_reopened',actorId:c.actorId,tournamentId:c.tournamentId,eventId:c.eventId,startId:c.startId,gameId:c.gameId,operationId:op,request:r,proposalId:status==='declined'?r.proposalId:'00000000-0000-4000-8000-000000000092',priorRevision:r.expectedRevision,priorHistoryDigest:r.expectedHistoryDigest,revision:status==='reopened'?0:null,historyDigest:status==='reopened'?'b'.repeat(64):null,simulationOnly:true,ordinaryScoreWritten:false,officialResultVerified:false,qualificationAuthorized:false,moneyMoved:false,historicalReceipt:false,currentSourceVerified:status==='reopened'};},recover:async()=>null};root.render(<NativeMixedGameReopenV1 key={mode} enabled runtime={runtime}/>);};