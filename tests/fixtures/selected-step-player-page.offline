import{createRoot}from'react-dom/client';import{SelectedStepPlayerEntryV3}from'../../src/components/selected-step-player-entry-v3';import{scope,playerView}from'../helpers/selected-step-player-view-fixture-v3.mjs';
const values=new Map();let view=playerView(),last=null,lost=true;window.sent=[];
const storage={read:k=>values.get(k)??null,retain(k,expected,next,archive){if((values.get(k)??null)!==expected)throw Error('changed');if(archive)values.set(archive.key,archive.raw);if(next===null)values.delete(k);else values.set(k,next);}};
const port={read:async()=>structuredClone(view),send:async p=>{window.sent.push(JSON.stringify(p));const r=p.request;last={status:'playoff_series_game_action_saved_v1',actorId:scope.actorId,tournamentId:scope.tournamentId,eventId:scope.eventId,qualificationId:scope.qualificationId,slot:scope.slot,operationId:r.operationId,request:r,generationId:scope.generationId,gameId:r.gameId,gameNumber:1,gameVersion:r.expectedGameVersion+1,action:r.action,verifiedGameId:null,completedResultId:null};view.gameId=r.gameId;view.gameVersion=last.gameVersion;if(r.action==='submit')view.ownSubmission={submissionId:r.submissionId,winnerParticipantId:r.winnerParticipantId};else view.ownConfirmed=true;if(lost){lost=false;throw Error('lost fictional reply');}return last;},check:async()=>({authorized:true,result:last})};
const root=createRoot(document.getElementById('root'));window.mount=()=>root.render(<SelectedStepPlayerEntryV3 enabled writesVerified scope={scope} storage={storage} port={port} subscribeIdentity={f=>{window.identity=f;f(scope.actorId);return()=>{window.identity=null;};}}/>);window.retained=()=>[...values.entries()];
