import{createRoot}from'react-dom/client';import{ModernManualPlayoffEntryV1}from'../../src/components/modern-manual-playoff-entry-v1';import{manualPlayoffFixtureV1 as fixture,id}from'../helpers/modern-manual-playoff-fixture-v1.mjs';
const values=new Map(),root=createRoot(document.getElementById('root'));let lost=true,serial=100,last=null;window.sent=[];
const storage={read:async k=>values.get(k)??null,transition:async(k,x,n,a)=>{if((values.get(k)??null)!==x)return false;if(a)values.set(a.id,a.raw);if(n===null)values.delete(k);else values.set(k,n);return true;}};
window.mount=(mode='player')=>{const c=fixture(mode==='player'?'player':'paper');if(mode==='review'){c.scope.actorId=id(9);c.view.actorId=id(9);c.view.canCapture=false;c.view.canReview=true;c.view.captureTargetId=id(80);c.view.awaitingPaperReview=true;}const view=c.view;
 const port={read:async()=>structuredClone(view),send:async p=>{window.sent.push(JSON.stringify(p));const r=p.request,evidenceId=id(serial++);view.version++;view.gameId=id(81);if(r.action==='digital-submit'||r.action==='digital-amend'){view.ownSubmission={id:evidenceId,winnerId:r.winnerId};view.canAmend=true;}if(r.action==='digital-confirm'){view.ownConfirmed=true;view.canAmend=false;}if(r.action.startsWith('handoff-')){view.ownHandoff=r.action;view.awaitingPaperReview=r.action==='handoff-yes';view.canProceedTentatively=r.action==='handoff-yes';view.disputed=r.action==='handoff-no';}if(r.action==='paper-capture'){view.canCapture=false;view.awaitingPaperReview=true;}if(r.action==='paper-review'){view.canReview=false;view.captureTargetId=null;view.verified=true;view.awaitingPaperReview=false;}last={actorId:c.scope.actorId,request:r,result:{status:'evidence_recorded',operationId:r.operationId,generationId:r.generationId,gameId:id(81),evidenceId,version:view.version,historicalReceipt:true,currentSourceVerified:false,moneyMoved:false}};if(lost){lost=false;throw Error('lost fictional reply');}return last;},check:async()=>last};
 root.render(<ModernManualPlayoffEntryV1 enabled writesVerified scope={c.scope} storage={storage} port={port} subscribeIdentity={f=>{window.identity=f;f(c.scope.actorId);return()=>{window.identity=null;};}}/>);};window.retained=()=>[...values.entries()];
