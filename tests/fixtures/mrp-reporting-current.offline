import React from'react';import{createRoot}from'react-dom/client';import{MrpMembershipReviewV1}from'../../src/components/mrp-membership-review-v1';const root=createRoot(document.getElementById('root')!);window.calls=[];window.mount=(mode='pending')=>{let w=structuredClone(window.workspace),n=20;if(mode==='nonmember')w.records[0].data.status='nonmember';const runtime={current:()=>true,now:()=>'2026-11-11T10:00:00.000Z',makeId:()=>'c0000000-0000-4000-8000-'+String(n++).padStart(12,'0'),read:async()=>structuredClone(w),reconcile:async()=>null,write:async(op,r)=>{window.calls.push(r);if(mode==='pending')return null;const row={id:'c0000000-0000-4000-8000-000000000030',version:2,priorId:w.currentHeadId,recordDigest:'b'.repeat(64),action:r.action,observationId:r.observationId,supersedesCorrectionId:r.supersedesCorrectionId,data:r.data,actorId:'c0000000-0000-4000-8000-000000000005',recordedAt:'2026-11-11T10:01:00.000Z'};w.records.push(row);Object.assign(w,{currentHeadId:row.id,currentHeadDigest:row.recordDigest,currentVersion:2});return{status:'manual_review_recorded',recordId:row.id,version:2,recordDigest:row.recordDigest,recordedAt:row.recordedAt,tournamentId:w.tournamentId,eventId:w.eventId,rosterEntryId:w.rosterEntryId,action:r.action,eligibility:'review_pending',awarded:null,currentHeadVerified:false,officialEligibilityDetermined:false,registrationChanged:false,mrpWritten:false};}};root.render(<MrpMembershipReviewV1 key={mode} enabled admitted actorId="c0000000-0000-4000-8000-000000000005" sessionId="c0000000-0000-4000-8000-000000000006" scope={window.scope} playerLabel="Tournament ID# A-1 — Fictional Reporter" runtime={runtime}/>);};