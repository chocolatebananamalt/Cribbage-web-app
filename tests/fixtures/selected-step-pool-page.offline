import{createRoot}from'react-dom/client';
import{SelectedStepPoolJournalSectionV3}from'../../src/components/selected-step-pool-journal-section-v3';
import{SelectedStepPoolResultsV3}from'../../src/components/selected-step-pool-results-v3';
import{id,scope,review,reply,retained}from'./selected-step-pool-v3.mjs';
const storage=retained();let actor=scope.actorId,notify=()=>{},workspace={status:'review',review:review(),version:0,proposalRevisionId:null},lost=true;
window.sends=[];window.retained=()=>({values:[...storage.values.values()],archives:[...storage.archives]});window.identity=next=>{actor=next;notify(next);};
const identity={current:async()=>actor,subscribe:f=>{notify=f;return()=>notify=()=>{};}},port={read:async()=>structuredClone(workspace),send:async(a,recover)=>{window.sends.push({raw:JSON.stringify(a),recover});workspace=a.request.kind==='selected-step-pool-save-v3'?{status:'review',review:review(),version:1,proposalRevisionId:id(20)}:{status:'recorded',review:review(),finalId:id(21)};if(lost){lost=false;throw Error('lost after mock commit');}return reply(a);}};
let operation=30;const root=createRoot(document.getElementById('root'));window.mount=()=>root.render(<><p>LOCAL FICTIONAL UI ONLY — No Database or Money</p><SelectedStepPoolJournalSectionV3 enabled writesVerified scope={scope} role="director" storage={storage} port={port} identity={identity} makeOperationId={()=>id(operation++)}/></>);window.unmount=()=>root.unmount();
window.mountResults=()=>{const r=review(),side={...r.pools[0],poolId:id(10),label:'Ten Dollar Side Pool',kind:'side',method:'side-sheet',roundingUnitMinor:1000,recipients:r.pools[0].recipients.map((x,i)=>({...x,amountMinor:[9000,6000,2000][i]}))};r.pools.push(side);r.sideMinor=17000;r.totalMinor=34000;root.render(<><p>LOCAL FICTIONAL RESULTS ONLY — No Database or Money</p><SelectedStepPoolResultsV3 view={{status:'available',recordedAt:'2026-11-10T12:00:00Z',review:r,sourceObservation:'locked_current_source',moneyMoved:false,payoutAuthorized:false}}/></>);};
