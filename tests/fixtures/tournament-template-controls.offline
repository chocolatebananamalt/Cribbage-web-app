import React from'react';import{createRoot}from'react-dom/client';import{TournamentTemplateControlsV1}from'../../src/components/tournament-template-controls-v1';const root=createRoot(document.getElementById('root')!);window.applied=0;window.mount=()=>root.render(<TournamentTemplateControlsV1 disabled={false} canApply={true} makeTemplate={name=>({...window.template,name})} onApply={()=>{window.applied++;return true;}}/>);