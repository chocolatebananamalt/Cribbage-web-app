import {createRoot} from 'react-dom/client';
import {SatelliteFinanceAuthoringV1} from '../../src/components/satellite-finance-authoring-v1';
const id=n=>`d0000000-0000-4000-8000-${String(n).padStart(12,'0')}`;
const scopes={a:{actorId:id(1),tournamentId:id(2),eventId:id(3)},event:{actorId:id(1),tournamentId:id(2),eventId:id(4)},account:{actorId:id(5),tournamentId:id(2),eventId:id(4)}};
const values=new Map(),archives=[],ops=new Map(),ports=new Map(),hides=new Map();let ids=1000,mode='normal',allowed=true;window.calls=[];window.reads=0;window.idCount=0;window.writes=0;
const storage={read:async k=>values.get(k)??null,transition:async(k,old,next,archive,signal)=>{if(signal?.aborted||(values.get(k)??null)!==old)return false;if(next===null)values.delete(k);else values.set(k,next);if(archive)archives.push(archive);return true;}};
const workspace=s=>({kind:'satellite-finance-workspace-v1',...s,sourceDigest:'d'.repeat(64),incomeHeadVersion:0,reviewHeadVersion:0,regularEntryMinor:8000,benefitMinor:0,expenseMinor:1000,additionalIncomeMinor:0,fundMinor:7000,reviewCurrent:false,reviewStatus:'not_reviewed',held:true,incomeHeads:[],bankReceiptVerified:false,payoutAuthorized:false,moneyMoved:false});
function portFor(name){if(ports.has(name))return ports.get(name);const s=scopes[name],p={read:async()=>{window.reads++;if(!allowed)throw Error('Fictional identity unavailable');return mode==='unavailable'?{status:'source_unavailable'}:{status:'ready',workspace:workspace(s)};},send:async(a,command)=>{window.calls.push({command,raw:JSON.stringify(a)});if(!allowed)throw Error('Fictional role revoked');if(ops.has(a.operationId))return ops.get(a.operationId);if(command==='recover')return{status:'pending',code:'committed_proof_not_found'};if(command==='record'&&mode==='blocked')return{status:'pending',code:'source_changed'};const p={status:command==='retire'?'satellite_finance_closed':'satellite_finance_recorded',action:a.request.action,...a.scope,operationId:a.operationId,recordId:id(9000+ops.size),sourceDigest:a.request.sourceDigest,request:a.request,historicalReceipt:true,currentSourceVerified:false,moneyMoved:false,payoutAuthorized:false};ops.set(a.operationId,p);if(command==='record')window.writes++;if(mode==='lost'&&command==='record')throw Error('Lost fictional acknowledgement');return p;}};ports.set(name,p);return p;}
const root=createRoot(document.getElementById('root'));
window.mount=(name='a',verified=true)=>root.render(<><p>LOCAL FICTIONAL FINANCE ONLY</p><SatelliteFinanceAuthoringV1 enabled writesVerified={verified} scope={scopes[name]} eventName={`Fictional Satellite ${name}`} role="director" storage={storage} port={portFor(name)} makeId={()=>{window.idCount++;return id(ids++);}} subscribeIdentity={f=>{hides.set(name,f);return()=>{if(hides.get(name)===f)hides.delete(name);};}}/></>);
window.hide=name=>{allowed=false;hides.get(name)?.();};window.allow=()=>{allowed=true;};window.setMode=m=>mode=m;
window.retained=()=>({values:[...values.entries()],archives});window.unmount=()=>root.unmount();
