import {createRoot} from 'react-dom/client';import {useState} from 'react';import {NativeMixedReviewProviderV1} from '../../src/components/native-mixed-review-provider-v1';
const data=window.__fixture;window.__providerCounts={clients:0,users:0,claims:0,roles:0,fetches:0};window.__authListeners=new Set();window.__identity={actorId:data.context.scope.actorId,sessionId:data.context.sessionId,role:'director',anonymous:false};window.__online=true;Object.defineProperty(navigator,'onLine',{configurable:true,get:()=>window.__online});window.__emitAuth=()=>window.__authListeners.forEach(fn=>fn('SIGNED_IN',null));
window.fetch=async(path,options)=>{window.__providerCounts.fetches++;window.__lastFetch={path,method:options?.method};const value=structuredClone(data.envelope);Object.assign(value,{actorId:window.__identity.actorId,sessionId:window.__identity.sessionId});const status=['director','co_director'].includes(window.__identity.role)?200:403,response=new Response(JSON.stringify(status===200?value:{error:'permission_required'}),{status,headers:{'content-type':'application/json'}});if(window.__holdFetch){window.__holdFetch=false;await new Promise(r=>window.__releaseFetch=r);}return response;};
function App(){const[enabled,setEnabled]=useState(false),[eventId,setEventId]=useState(data.context.scope.eventId);return <main style={{maxWidth:1100,padding:12,margin:'0 auto',minWidth:0,overflowWrap:'anywhere'}}><h1>Fictional Read-Only Provider</h1><nav><button onClick={()=>setEnabled(true)}>Enable Provider</button><button onClick={()=>setEnabled(false)}>Disable Provider</button><button onClick={()=>{window.__identity.role='player';window.__emitAuth();}}>Player Role</button><button onClick={()=>{window.__identity.role='co_director';window.__emitAuth();}}>Co-Director Role</button><button onClick={()=>{window.__identity.role='director';window.__identity.anonymous=false;window.__emitAuth();}}>Director Role</button><button onClick={()=>{window.__identity.anonymous=true;window.__emitAuth();}}>Anonymous</button><button onClick={()=>{window.__identity.actorId='b1310000-0000-4000-8000-000000000997';window.__emitAuth();}}>Change Account</button><button onClick={()=>{window.__identity.sessionId='b1310000-0000-4000-8000-000000000996';window.__emitAuth();}}>Change Session</button><button onClick={()=>setEventId('b1310000-0000-4000-8000-000000000995')}>Change Event</button><button onClick={()=>setEventId(data.context.scope.eventId)}>Original Event</button><button onClick={()=>window.__emitAuth()}>Refresh Auth Epoch</button><button onClick={()=>{window.__online=false;dispatchEvent(new Event('offline'));}}>Go Offline</button><button onClick={()=>{window.__online=true;dispatchEvent(new Event('online'));}}>Reconnect</button></nav><NativeMixedReviewProviderV1 enabled={enabled} tournamentId={data.context.scope.tournamentId} eventId={eventId}/></main>;}
createRoot(document.getElementById('root')).render(<App/>);
