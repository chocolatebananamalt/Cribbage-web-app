import{createRoot}from'react-dom/client';
import{ModernEventCloseSectionV1}from'../../src/components/modern-event-close-section-v1';
import{createIndexedFinanceDraftRetainedV1}from'../../src/lib/finance/event-finance-draft-retained-v1';
const listeners=new Set();
export const createClient=()=>({auth:{onAuthStateChange:fn=>{listeners.add(fn);return{data:{subscription:{unsubscribe:()=>listeners.delete(fn)}}};}}});
export const trackAppRecoveryWrite=fn=>fn();
const config=window.fixtureConfig,storage=createIndexedFinanceDraftRetainedV1(),scope=config.attempt.scope,key=`modern-event-close-v1:${scope.actorId}:${scope.tournamentId}:${scope.eventId}`,foreignKey='modern-event-close-v1:foreign-fictional-owner';
const root=createRoot(document.getElementById('root'));
const f=window.fixture={storage,key,foreignKey,callbacks:null,captured:null,write:true,enabled:true,actor:scope.actorId,scope,attempt:config.attempt,raw:config.raw,render(){const activeScope={...scope,actorId:f.actor};root.render(<ModernEventCloseSectionV1 enabled writesVerified scope={activeScope} terminalRecoveryVerified={f.enabled} terminalRetirementVerified={f.write}/>);},capture(callbacks){f.callbacks=callbacks;},async rawPending(){return await storage.read(key);},async history(){return await new Promise((resolve,reject)=>{const request=indexedDB.open('cribbage-finance-device-drafts-v1',1);request.onsuccess=()=>{const db=request.result,tx=db.transaction('history','readonly'),store=tx.objectStore('history'),read=store.getAll();read.onsuccess=()=>resolve(read.result);read.onerror=()=>reject(Error('fixture_history'));tx.oncomplete=()=>db.close();};request.onerror=()=>reject(Error('fixture_database'));});},auth(actor){for(const fn of listeners)fn('SIGNED_IN',{user:{id:actor}});},async replace(raw){const before=await storage.read(key);if(!await storage.transition(key,before,raw))throw Error('fixture_replace_conflict');},async conflictArchive(){await new Promise((resolve,reject)=>{const request=indexedDB.open('cribbage-finance-device-drafts-v1',1);request.onsuccess=()=>{const db=request.result,tx=db.transaction('history','readwrite');tx.objectStore('history').put('foreign immutable fixture history',`${key}:terminal-v18:${config.attempt.operationId}`);tx.oncomplete=()=>{db.close();resolve();};tx.onerror=()=>reject(Error('fixture_history'));};});}};
void(async()=>{if(!sessionStorage.getItem('fixture_seeded')){if(!await storage.transition(key,null,config.raw))throw Error('fixture_seed');if(!await storage.transition(foreignKey,null,'foreign recovery bytes preserved'))throw Error('foreign_seed');sessionStorage.setItem('fixture_seeded','yes');}f.render();})();
