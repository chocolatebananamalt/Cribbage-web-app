import React from 'react';import{createRoot}from'react-dom/client';import{SatelliteCompletionEvidenceV1}from'../../src/components/satellite-completion-evidence-v1';
const root=createRoot(document.getElementById('root')!);window.mount=(mode='ready')=>{const value={resultVersionId:'fictional-result-version',order:mode==='tie'?{status:'held',code:'finishing_ties_unresolved'}:{status:'matches_authoritative_score_order',checkedRecordedPlaces:2,rows:[{participantId:'a',placement:1,displayName:'Fictional Winner',verifiedGames:12,gamePoints:30,gamesWon:10,netSpreadPoints:50,plusPoints:100},{participantId:'b',placement:2,displayName:'Fictional Runner',verifiedGames:12,gamePoints:27,gamesWon:9,netSpreadPoints:20,plusPoints:80}]},fund:{status:mode==='missing'?'held':'director_reviewed_recorded_fund',code:mode==='short'?'recorded_awards_exceed_recorded_fund':mode==='missing'?'additional_income_and_fund_review_required':'current_recorded_coverage_review',directorDeclaredFundReviewCurrent:mode!=='missing',recordedRegularFundMinor:7000,enteredRegularAwardsMinor:mode==='short'?7500:7000,differenceMinor:mode==='short'?-500:0,additionalIncomeMinor:mode==='missing'?null:0}};root.render(<SatelliteCompletionEvidenceV1 value={mode==='unavailable'?null:value as never} eventName="Fictional Satellite"/>);};
