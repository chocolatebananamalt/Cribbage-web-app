import {createRoot} from 'react-dom/client';import {useMemo,useState} from 'react';import {NativeMixedReviewSectionV1} from '../../src/components/native-mixed-review-section-v1';
const data=window.__fixture;window.__reviewReads=0;window.__pending=new Map([['fictional-existing-pending','keep-exact-pending']]);
function App(){const[enabled,setEnabled]=useState(false),[online,setOnline]=useState(true),[mode,setMode]=useState('valid'),[readerVersion,setReaderVersion]=useState(0),[other,setOther]=useState(false),context=useMemo(()=>other?{...data.context,scope:{...data.context.scope,actorId:'b1310000-0000-4000-8000-000000000999'}}:data.context,[other]),read=useMemo(()=>async()=>{window.__reviewReads++;let value=structuredClone(data.envelope);if(mode==='reversed')value.review.cards.reverse();if(mode==='tied'){value.review.cards.forEach(c=>Object.assign(c,{wins:6,losses:6,gamePoints:12,positiveSpread:100,negativeSpread:100,netSpread:0,rank:1,tieCount:18}));Object.assign(value.review,{qualificationReady:false,tieReviewRequired:true,tieReviewReason:'All 18 fictional cards require tie review.'});}if(mode==='null')value=null;if(mode==='malformed')value.review.cards.pop();if(mode==='foreign')value.actorId='b1310000-0000-4000-8000-000000000998';if(mode==='authority')value.review.payoutAuthorized=true;if(window.__holdReview){window.__holdReview=false;await new Promise(r=>window.__releaseReview=r);}if(mode==='unavailable')throw Error('Fictional unavailable read');return value;},[mode,readerVersion]);return <main style={{maxWidth:1100,minWidth:0,padding:12,margin:'0 auto',overflowWrap:'anywhere'}}><h1>Fictional Practice Review</h1><label>Unrelated Unsaved Editor<textarea defaultValue="Keep this unsaved draft"/></label><nav><button onClick={()=>setEnabled(true)}>Enable Review</button><button onClick={()=>setEnabled(false)}>Disable Review</button><button onClick={()=>setOnline(false)}>Go Offline</button><button onClick={()=>setOnline(true)}>Reconnect</button><button onClick={()=>setReaderVersion(n=>n+1)}>Replace Reader</button><button onClick={()=>setOther(true)}>Other Account</button><button onClick={()=>setOther(false)}>Original Account</button>{['valid','reversed','tied','null','malformed','foreign','authority','unavailable'].map(m=><button key={m} onClick={()=>{setMode(m);setReaderVersion(n=>n+1);}}>{'Source '+m}</button>)}</nav><NativeMixedReviewSectionV1 enabled={enabled} context={context} online={online} read={read}/></main>;}
createRoot(document.getElementById('root')).render(<App/>);
