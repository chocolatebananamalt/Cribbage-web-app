import{createRoot}from'react-dom/client';import{SelectedStepOwnershipSectionV3}from'../../src/components/selected-step-ownership-section-v3';
import{id,scope,retained}from'./selected-step-pool-v3.mjs';
const storage=retained(),base={kind:'selected-step-ownership-review-v3',sourceDigest:'a'.repeat(64),version:0,priorRevisionId:null,reviewIsCurrent:false,costs:[{expenseEventId:id(41),description:'Coffee',amountMinor:1000},{expenseEventId:id(42),description:'Printing',amountMinor:2000}],funds:{regularReceiptsMinor:30000,qReceiptsMinor:17000,sideReceiptsMinor:17000,recordedReceiptsMinor:64000},moneyMoved:false,finalizationAuthorized:false};let current=false,lost=true,actor=scope.actorId,notify=()=>{},operation=30;window.sends=[];window.retained=()=>({values:[...storage.values.values()],archives:[...storage.archives]});window.identity=next=>{actor=next;notify(next);};
const identity={current:async()=>actor,subscribe:f=>{notify=f;return()=>notify=()=>{};}},port={read:async()=>({status:'review',review:current?{...base,version:1,priorRevisionId:id(50),reviewIsCurrent:true}:base}),send:async(a,recover)=>{window.sends.push({raw:JSON.stringify(a),recover});current=true;if(lost){lost=false;throw Error('lost after fictional commit');}return{status:'accepted',attempt:a,receipt:{status:'selected_step_pool_ownership_reviewed_v3',revisionId:id(50),version:1,...scope,operationId:a.operationId,sourceDigest:a.request.sourceDigest,moneyMoved:false,finalizationAuthorized:false},reviewedSource:a.review};}};
const root=createRoot(document.getElementById('root'));window.mount=verified=>root.render(<><p>LOCAL FICTIONAL OWNERSHIP UI — No Database or Money</p><SelectedStepOwnershipSectionV3 enabled writesVerified={verified} scope={scope} role="director" storage={storage} port={port} identity={identity} makeOperationId={()=>id(operation++)}/></>);
