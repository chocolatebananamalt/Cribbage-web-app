import {createRoot} from 'react-dom/client';import {useMemo,useState} from 'react';
import {NativeMixedDirectorPanelV1} from '../../src/components/native-mixed-director-panel-v1';
const x=window.__fixture.example,phase=window.__fixture.phase;window.__calls=[];
async function record(call){window.__calls.push(call);if(window.__holdWork){window.__releaseWork??={};return new Promise(resolve=>window.__releaseWork[call.controllerGeneration]=resolve);}return true;}
function App(){
 const[generation,setGeneration]=useState(0),[write,setWrite]=useState(true),[revision,setRevision]=useState(0),[controllerGeneration,setControllerGeneration]=useState(0),[snapshotGeneration,setSnapshotGeneration]=useState(0);window.__snapshotGeneration=snapshotGeneration;
 const controller=useMemo(()=>({activate:async()=>{},getSnapshot:()=>{const op=structuredClone(x.operations.draw);op.request.reason+=' '+window.__snapshotGeneration;if(phase==='pending'||phase==='check')return{status:'pending',operation:op,receipt:null,message:'Fictional uncertain draw'};if(phase==='resolved')return{status:'resolved',operation:op,receipt:x.histories.draw.receipt,message:'Fictional resolved step'};return{status:'blocked',operation:null,receipt:null,nextActionHint:phase,message:'Fictional prior step closed'};},submit:async op=>record({method:'submit',op,controllerGeneration}),advance:async op=>record({method:'advance',op,controllerGeneration}),check:async()=>record({method:'check',controllerGeneration}),cancelPending:async reason=>record({method:'cancelPending',reason,controllerGeneration}),archiveResolved:async()=>record({method:'archiveResolved',controllerGeneration})}),[controllerGeneration]);
 const operation=['review','publish'].includes(phase)?{...x.operations[phase],request:{...x.operations[phase].request,reason:x.operations[phase].request.reason+' '+revision}}:undefined;
 return <main style={{maxWidth:1100,padding:12,margin:'0 auto',minWidth:0,overflowWrap:'anywhere'}}><h1>Fictional Rehearsal UI</h1><nav><button onClick={()=>{setGeneration(n=>n+1);setWrite(true);setRevision(0);setSnapshotGeneration(0);}}>Reset Panel</button><button onClick={()=>setWrite(false)}>Disable Writes</button><button onClick={()=>setRevision(n=>n+1)}>Replace Prepared Operation</button><button onClick={()=>setControllerGeneration(n=>n+1)}>Replace Controller</button><button onClick={()=>setSnapshotGeneration(n=>n+1)}>Replace Pending Operation</button></nav><NativeMixedDirectorPanelV1 key={generation} enabled canRead canWrite={write} controller={controller} context={x.context} preparedOperation={operation} reviewMaterials={x.materials}/></main>;
}
createRoot(document.getElementById('root')).render(<App/>);
