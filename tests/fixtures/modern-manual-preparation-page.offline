import{createRoot}from'react-dom/client';import{ModernManualPreparationV1}from'../../src/components/modern-manual-preparation-v1';import{preparationFixtureV1 as fixture,prepId as id,openPreparationSlotsV1 as open}from'../helpers/modern-manual-preparation-fixture-v1.mjs';
const c=fixture(),values=new Map(),root=createRoot(document.getElementById('root'));let last=null,lost=true;window.sent=[];
const storage={read:async k=>values.get(k)??null,transition:async(k,x,n,a)=>{if((values.get(k)??null)!==x)return false;if(a)values.set(a.id,a.raw);if(n===null)values.delete(k);else values.set(k,n);return true;}};
const port={read:async()=>structuredClone(c.w),execute:async(a,checking)=>{if(checking)return last;window.sent.push(JSON.stringify(a));const code=a.action==='review'?'playoff_rules_reviewed':a.action==='start'?'playoff_start_recorded':'generation_recorded',recordId=id(a.action==='review'?30:a.action==='start'?31:32);if(a.action==='review')c.w.gateReviewId=recordId;if(a.action==='start'){c.w.startedCurrent=true;c.w.expectedStartId=recordId;open(c.w);}if(a.action==='generate'){const slot=c.w.slots.find(s=>s.slot===a.request.slot);slot.expectedVersion++;slot.generationId=recordId;slot.generationCurrent=true;}last={status:'accepted',attempt:a,code,recordId,historicalReceipt:true,currentSourceVerified:false,moneyMoved:false};if(lost){lost=false;throw Error('lost fictional reply');}return last;}};
window.mount=()=>root.render(<ModernManualPreparationV1 enabled writesVerified scope={c.scope} port={port} storage={storage} subscribeIdentity={f=>{window.identity=f;f(c.scope.actorId);return()=>{window.identity=null;};}}/>);window.retained=()=>[...values.entries()];
