import{createRoot}from'react-dom/client';import{PlayerPoolTotalsV1}from'../../src/components/player-pool-totals-v1';import{PlayerPoolVisibilitySectionV1}from'../../src/components/player-pool-visibility-section-v1';
import{id,scope,retained}from'./selected-step-pool-v3.mjs';
const root=createRoot(document.getElementById('root')),store=retained();let actor=scope.actorId,notify=()=>{},version=0,enabled=false,lost=true,op=30;window.sends=[];window.retained=()=>({values:[...store.values.values()],archives:[...store.archives]});window.identity=x=>{actor=x;notify(x);};window.otherEnable=()=>{version++;enabled=true;};
const view=()=>({kind:'player-pool-visibility-settings-v1',tournamentId:scope.tournamentId,eventId:scope.eventId,version,enabled}),receipt=a=>({status:'visibility_recorded',...scope,operationId:a.operationId,request:a.request,revisionId:id(80),version:a.request.expectedVersion+1,enabled:a.request.enabled,historicalReceipt:true,currentVisibilityVerified:false});
const identity={current:async()=>actor,subscribe:f=>{notify=f;return()=>notify=()=>{};}},port={read:async()=>({status:'review',review:view()}),send:async(a,mode)=>{window.sends.push({raw:JSON.stringify(a),mode});if(mode==='resolve_stale')return{status:'closed',attempt:a,closure:{status:'visibility_request_closed',...scope,operationId:a.operationId,request:a.request,closureId:id(81),observedVersion:version,code:'stale_version',historicalReceipt:true,currentVisibilityVerified:false}};if(mode===true)return{status:'accepted',attempt:a,receipt:receipt(a)};if(a.request.expectedVersion!==version)return{status:'rejected',attempt:a,code:'stale_version'};version++;enabled=a.request.enabled;if(lost){lost=false;throw Error('lost after fictional commit');}return{status:'accepted',attempt:a,receipt:receipt(a)};}};
window.mountVisibility=()=>root.render(<><p>LOCAL FICTIONAL VISIBILITY UI — No Database or Sharing Change</p><PlayerPoolVisibilitySectionV1 enabled writesVerified scope={scope} role="director" port={port} storage={store} identity={identity} makeOperationId={()=>id(op++)}/></>);
window.mountTotals=()=>root.render(<><p>LOCAL FICTIONAL PLAYER AGGREGATE — No Database</p><PlayerPoolTotalsV1 tournamentId={scope.tournamentId} eventId={scope.eventId} view={{kind:'player-pool-totals-v1',tournamentId:scope.tournamentId,eventId:scope.eventId,observedAt:'2026-11-10T12:00:00.000Z',visibilityVersion:1,qState:'available',sideState:'available',pools:[{poolId:id(90),kind:'q',name:'Q-Pool $10',entryFeeMinor:1000,participantCount:3,poolTotalMinor:1000,ifAllEnteredPayMinor:3000},{poolId:id(91),kind:'side',name:'Side Pool $10',entryFeeMinor:1000,participantCount:2,poolTotalMinor:null,ifAllEnteredPayMinor:2000}],projectedAmountsAreEstimates:true,awardScheduleAvailable:false,moneyMoved:false}}/></>);
