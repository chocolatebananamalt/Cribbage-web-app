import {createRoot} from 'react-dom/client';import {useMemo,useState} from 'react';import {NativeMixedStartPanelV1} from '../../src/components/native-mixed-start-panel-v1';
const data=window.__fixture;window.__calls=[];window.__activationCalls=[];window.__snapshotReads=0;window.__requestGeneration=0;window.__statusOverride=null;
async function record(method,controllerGeneration,confirmed){window.__calls.push({method,controllerGeneration,confirmed});if(window.__holdWork){window.__releaseWork??={};return new Promise(r=>window.__releaseWork[controllerGeneration]=r);}return true;}
function App(){const[generation,setGeneration]=useState(0),[online,setOnline]=useState(true),[allow,setAllow]=useState(true),[enabled,setEnabled]=useState(data.phase!=='disabled'),[controllerGeneration,setControllerGeneration]=useState(0),[contextGeneration,setContextGeneration]=useState(0),[,render]=useState(0),context=useMemo(()=>({...data.context,sessionId:data.context.sessionId+'-'+contextGeneration}),[contextGeneration]);const controller=useMemo(()=>({activate:async context=>{window.__activationCalls.push({controllerGeneration,hasContext:!!context});return true;},getSnapshot:()=>{window.__snapshotReads++;const request=structuredClone(data.request);request.reason+=' '+window.__requestGeneration;return{status:window.__statusOverride??(['retry','check'].includes(data.phase)?'pending':'ready'),request:data.phase==='prepare'?null:request,phase:data.phase==='retry'?'not_sent':data.phase==='check'?'attempted':null,receipt:null,currentStarted:false,message:'Fictional current Start snapshot '+window.__requestGeneration};},prepare:async()=>record('prepare',controllerGeneration),submit:async confirmed=>record('submit',controllerGeneration,confirmed),retryExact:async()=>record('retryExact',controllerGeneration),check:async()=>record('check',controllerGeneration)}),[controllerGeneration]);return <main style={{maxWidth:1000,padding:12,margin:'0 auto',minWidth:0,overflowWrap:'anywhere'}}><h1>Fictional Start UI</h1><nav><button onClick={()=>{setGeneration(n=>n+1);setOnline(true);setAllow(true);setEnabled(true);window.__requestGeneration=0;window.__statusOverride=null;}}>Reset Start</button><button onClick={()=>setOnline(false)}>Go Offline</button><button onClick={()=>setAllow(false)}>Revoke Prepare</button><button onClick={()=>setEnabled(false)}>Disable Start</button><button onClick={()=>setControllerGeneration(n=>n+1)}>Replace Start Controller</button><button onClick={()=>setContextGeneration(n=>n+1)}>Replace Start Context</button><button onClick={()=>{window.__requestGeneration++;render(n=>n+1);}}>Replace Start Request</button></nav><NativeMixedStartPanelV1 key={generation} enabled={enabled} context={context} controller={controller} online={online} allowPrepare={allow}/></main>;}
createRoot(document.getElementById('root')).render(<App/>);


