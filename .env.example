# Public Supabase values only. Keep credentials out of this template.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Deliberately keep staged features closed in every new environment. These
# values are examples only; enabling a staged gate requires its documented
# release sequence and real independent-session evidence.
ACC_REGISTRATION_LINK_MANAGEMENT_V2=disabled
ACC_PUBLIC_REGISTRATION_V2=disabled
ACC_ACCOUNT_ACTIVATION_ENABLED=false
ACC_TOURNAMENT_SETUP_ACTIVATION_ENABLED=disabled
ACC_PAPER_CARD_CAPTURE_ENABLED=disabled
ACC_EVENT_FINALIZATION_READINESS_ENABLED=disabled
ACC_RULE12_CORRECTION_ENABLED=disabled

# Optional providers remain closed for the October pilot. Run
# `pnpm providers:check` before deployment and `pnpm providers:check
# --require=<capability>` while preparing one provider. Never use NEXT_PUBLIC_
# for any sensitive credential, token, webhook credential, or provider key.
ACC_ONLINE_PAYMENTS_ENABLED=disabled
ACC_PAYMENT_PROVIDER=
ACC_PAYMENT_POLICY_REF=
ACC_STRIPE_ADAPTER_VERSION=
ACC_STRIPE_TEST_EVIDENCE_REF=

ACC_SMS_SEATING_ENABLED=disabled
ACC_SMS_PROVIDER=
SMS_SENDER_ID=
ACC_SMS_CONSENT_POLICY_REF=
ACC_SMS_ADAPTER_VERSION=
ACC_SMS_TEST_EVIDENCE_REF=

ACC_PAPER_CARD_OCR_ENABLED=disabled
ACC_OCR_PROVIDER=
ACC_OCR_EXECUTION_MODE=
SUPABASE_PAPER_CARD_BUCKET=
ACC_PAPER_CARD_RETENTION_POLICY_REF=
ACC_OCR_ADAPTER_VERSION=
ACC_OCR_TEST_EVIDENCE_REF=
