import {isNativeMixedGameTargetV1,type NativeMixedGameTargetV1}from'./native-mixed-game-evidence-v1.ts';
import {readNativeMixedPaperBindingV1}from'./native-mixed-paper-entry-view-v1.ts';
import type {NativeMixedOwnClientV1}from'../api/native-mixed-game-evidence-transport-v1.ts';
export const nativeMixedPaperRouteEnabledV1=()=>false;
const uuid=(v:unknown):v is string=>typeof v==='string'&&/^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(v);
export async function prepareNativeMixedPaperRouteV1(o:{enabled?:boolean;params:{tournamentId:string;eventId:string;startId:string;gameId:string};projectUrl:string;projectRef:string;createAuthenticated:()=>Promise<NativeMixedOwnClientV1>;now?:()=>number}):Promise<{target:NativeMixedGameTargetV1}|null>{
 if(o.enabled!==true)return null;const p=structuredClone(o.params),url=o.projectUrl,ref=o.projectRef;
 if(Object.keys(p).sort().join()!=='eventId,gameId,startId,tournamentId'||!Object.values(p).every(uuid))return null;
 try{const client=await o.createAuthenticated();
  async function subject(){const u=await client.auth.getUser(),c=await client.auth.getClaims(),v=c.data?.claims;return !u.error&&!c.error&&uuid(u.data.user?.id)&&v?.sub===u.data.user.id&&uuid(v?.session_id)&&typeof v.exp==='number'&&Number.isSafeInteger(v.exp)&&v.exp*1000>(o.now?.()??Date.now())?{actorId:u.data.user.id,sessionId:v.session_id}:null;}
  const before=await subject();if(!before)return null;
  const response=await client.rpc('get_native_mixed_paper_binding_v1',{p_tournament_id:p.tournamentId,p_event_id:p.eventId,p_start_id:p.startId,p_game_id:p.gameId});
  const after=await subject();if(!after||JSON.stringify(before)!==JSON.stringify(after)||response.error||!response.data||typeof response.data!=='object')return null;
  const raw=response.data as Record<string,unknown>,target={...before,projectUrl:url,projectRef:ref,...p,startSourceDigest:raw.startSourceDigest};
  return isNativeMixedGameTargetV1(target)&&readNativeMixedPaperBindingV1(raw,target)?{target}:null;
 }catch{return null;}
}
