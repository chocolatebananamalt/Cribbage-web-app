import{readNativeMixedDirectorReviewMaterialsV1}from'./native-mixed-director-review-materials-v1.ts';
import{readNativeMixedSimulationOperationV1,isNativeMixedSimulationOperationV1,type NativeMixedSimulationOperationV1,type NativeMixedSimulationOperationReadV1,type NativeMixedSimulationScopeV1}from'./native-mixed-simulation-operation-v1.ts';
import{readNativeMixedDirectorTransitionV1,type NativeMixedDirectorTransitionV1}from'./native-mixed-director-transition-v1.ts';
export type NativeMixedPreparationV1={kind:'native-mixed-pilot-preparation-v1';actorId:string;tournamentId:string;eventId:string;tournamentName:string;eventName:string;phase:'plan'|'draw'|'review'|'publish'|'published';attendance:{sealId:string;sourceDigest:string};geometry:{tableId:'A';seatCount:18;fixedSeat:'A-1'};history:Partial<Record<'plan'|'draw'|'review'|'publish',NativeMixedSimulationOperationReadV1>>;transition:NativeMixedDirectorTransitionV1|null;observedAt:string;writesEnabled:boolean;currentSourceVerified:true;writeAuthorized:false;humanPresenceVerified:false};
const exact=(v:unknown,keys:string[]):v is Record<string,unknown>=>!!v&&typeof v==='object'&&!Array.isArray(v)&&Object.getPrototypeOf(v)===Object.prototype&&Object.keys(v).length===keys.length&&keys.every(k=>Object.hasOwn(v,k));
const uuid=(v:unknown):v is string=>typeof v==='string'&&/^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(v);
export function readNativeMixedPreparationV1(value:unknown,scope:NativeMixedSimulationScopeV1,now=Date.now()):NativeMixedPreparationV1|null{
 if(!exact(value,['kind','actorId','tournamentId','eventId','tournamentName','eventName','phase','attendance','geometry','history','transition','observedAt','writesEnabled','currentSourceVerified','writeAuthorized','humanPresenceVerified'])||value.kind!=='native-mixed-pilot-preparation-v1'||value.actorId!==scope.actorId||value.tournamentId!==scope.tournamentId||value.eventId!==scope.eventId||value.currentSourceVerified!==true||value.writeAuthorized!==false||value.humanPresenceVerified!==false||typeof value.writesEnabled!=='boolean')return null;
 if(typeof value.tournamentName!=='string'||!value.tournamentName.startsWith('TEST ONLY')||value.tournamentName.length>2000||typeof value.eventName!=='string'||!value.eventName.trim()||value.eventName.length>2000)return null;
 if(!exact(value.attendance,['sealId','sourceDigest'])||!uuid(value.attendance.sealId)||typeof value.attendance.sourceDigest!=='string'||!/^[a-f0-9]{64}$/.test(value.attendance.sourceDigest)||!exact(value.geometry,['tableId','seatCount','fixedSeat'])||value.geometry.tableId!=='A'||value.geometry.seatCount!==18||value.geometry.fixedSeat!=='A-1')return null;
 const phases=['plan','draw','review','publish','published'],index=phases.indexOf(String(value.phase));if(index<0||typeof value.observedAt!=='string')return null;const when=Date.parse(value.observedAt);if(!Number.isFinite(when)||new Date(when).toISOString()!==value.observedAt||when>now||now-when>30000)return null;
 const actions=['plan','draw','review','publish']as const;if(!exact(value.history,actions.slice(0,index)))return null;const history:NativeMixedPreparationV1['history']={};
 for(const action of actions.slice(0,index)){const raw=value.history[action];if(!raw||typeof raw!=='object'||!('operationId'in raw)||!uuid(raw.operationId))return null;const h=readNativeMixedSimulationOperationV1(raw,{scope,operationId:raw.operationId});if(!h||h.action!==action||h.receipt.status!=='accepted'||h.request.expectedAttendanceSourceDigest!==value.attendance.sourceDigest)return null;history[action]=h;}
 if(history.draw&&(history.draw.request.kind!=='native-mixed-simulation-draw-v1'||history.draw.request.planId!==history.plan?.receipt.planId||history.draw.request.expectedPlanDigest!==history.plan?.receipt.sourceDigest))return null;
 if(history.review&&(history.review.request.kind!=='native-mixed-simulation-review-v1'||history.review.request.drawId!==history.draw?.receipt.drawId||history.review.request.expectedDrawDigest!==history.draw?.receipt.sourceDigest))return null;
 if(history.publish&&(history.publish.request.kind!=='native-mixed-simulation-publish-v1'||history.publish.request.reviewId!==history.review?.receipt.reviewId||history.publish.request.expectedReviewDigest!==history.review?.receipt.sourceDigest))return null;
 let transition:NativeMixedDirectorTransitionV1|null=null;if(index>0&&index<4){const h=history[actions[index-1]]!;transition=readNativeMixedDirectorTransitionV1(value.transition,{scope,prior:{action:h.action,operationId:h.operationId,request:h.request}as NativeMixedSimulationOperationV1,now});if(!transition||transition.nextAction!==value.phase)return null;}else if(value.transition!==null)return null;
 return structuredClone({...value,history,transition})as NativeMixedPreparationV1;
}
export function authorNativeMixedPreparationOperationV1(source:NativeMixedPreparationV1,scope:NativeMixedSimulationScopeV1,ids:{operationId:string;seatingOperationId?:string;scheduleOperationId?:string},approval:{layoutReviewed:boolean;noSpecialRequests:boolean},now=Date.now()):NativeMixedSimulationOperationV1|null{
 const s=readNativeMixedPreparationV1(source,scope,now);if(!s||!s.writesEnabled||s.phase==='published'||!uuid(ids.operationId)||Object.values(s.history).some(h=>h.operationId===ids.operationId))return null;
 const reason=s.phase==='plan'?'Director reviewed A18; no special seating requests for this test':'Director prepared this test-only rehearsal step',base={operationId:ids.operationId,reason,expectedAttendanceSourceDigest:s.attendance.sourceDigest};let request:unknown;
 if(s.phase==='plan'){if(!approval.layoutReviewed||!approval.noSpecialRequests)return null;request={kind:'native-mixed-simulation-plan-v1',...base,expectedAttendanceSealId:s.attendance.sealId,config:{tables:[{tableId:'A',seatCount:18}],activePairIds:Array.from({length:9},(_,i)=>`A:${i*2+1}-${i*2+2}`),anchor:{participantId:null,seatId:'A-1',directorApproved:true},stationaryRequests:[],stationaryDecisions:[],constraints:[],maxAttempts:8}};}
 else if(s.phase==='draw')request={kind:'native-mixed-simulation-draw-v1',...base,planId:s.transition!.parentId,expectedPlanDigest:s.transition!.parentDigest};
 else if(s.phase==='review')request={kind:'native-mixed-simulation-review-v1',...base,drawId:s.transition!.parentId,expectedDrawDigest:s.transition!.parentDigest,decision:'accepted-test-simulation-only',humanPresenceNotVerified:true,simulationLayoutReviewed:true,fictionalPaperAcknowledged:true};
 else{if(!uuid(ids.seatingOperationId)||!uuid(ids.scheduleOperationId)||new Set([ids.operationId,ids.seatingOperationId,ids.scheduleOperationId]).size!==3)return null;request={kind:'native-mixed-simulation-publish-v1',...base,reviewId:s.transition!.parentId,expectedReviewDigest:s.transition!.parentDigest,seatingOperationId:ids.seatingOperationId,scheduleOperationId:ids.scheduleOperationId};}
 const operation={action:s.phase,operationId:ids.operationId,request};if(!isNativeMixedSimulationOperationV1(operation))return null;if(['review','publish'].includes(operation.action)&&!readNativeMixedDirectorReviewMaterialsV1(s.history,scope,operation))return null;return operation;
}

export const nativeMixedPreparationPageEnabledV1=()=>false;
